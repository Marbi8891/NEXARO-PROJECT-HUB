# Copy to .env and fill in. Never commit .env.
POSTGRES_DB=nexaro
POSTGRES_USER=nexaro
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Encrypts stored GitHub tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If you change it later, stored GitHub tokens must be reconnected.
NEXARO_SECRET_KEY=change-me-to-a-long-random-secret

# "production" hides /api/docs. Use "development" locally for the Swagger UI.
NEXARO_ENV=production
# Set to true when the hub is served over HTTPS.
NEXARO_COOKIE_SECURE=false
# Create the 7 initial project records (names only, marked as pending).
NEXARO_SEED_INITIAL_PROJECTS=true
HUB_PORT=8080
